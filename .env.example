# 정사평 — 개발/시연 스택 설정
# setup.sh 가 이 파일을 .env 로 복사하고 JWT_SECRET 을 채웁니다.
# 이미 .env 가 있으면 건드리지 않습니다.

# ── LLM ───────────────────────────────────────────────────────────────────
# ollama(로컬) | openai | anthropic | gemini
LLM_PROVIDER=ollama
# 호스트 RAM 8GB 기준. 여유가 있으면 llama3.1:8b 도 가능합니다.
LLM_MODEL=qwen2.5:3b
# 이 점수 이상만 LLM 해설 대상. 낮추면 처리량이 급증합니다.
# CPU 추론 실측: qwen2.5:3b 건당 ~27초, exaone3.5:7.8b 건당 ~60초.
# 게이트는 최적화가 아니라 파이프라인이 성립하기 위한 조건입니다 —
# 고위험 45,075건을 60초로 전부 해설하면 31.8일, 게이트 없이 전량이면 725일.
LLM_MIN_SCORE=70
LLM_POLL_INTERVAL_SEC=60
LLM_BATCH_SIZE=10

# 위험도를 누가 정하는가: derive(점수에서 계산, 기본) | model(LLM 이 판정)
# model 로 두면 3B 가 고위험 10건 중 10건을 낮게 매겼고 7B 도 2/10 에 그쳤습니다.
# 그래도 점수보다 낮게 잡는 것은 막습니다(올려잡는 것만 수용).
LLM_SEVERITY=derive

# LLM 호출 실패 시 재시도 횟수. 실패하면 폴백 문구를 씁니다.
LLM_MAX_RETRIES=2

# 파싱 실패 시 폴백 문서를 쓸지. false 면 그 건을 건너뜁니다.
LLM_WRITE_FALLBACK=true

# 커서가 없을 때 되돌아볼 범위. 보관 로그를 적재했다면 늘려야 합니다.
LLM_BOOTSTRAP_WINDOW=now-24h

# 외부 제공자를 쓸 때만 채우세요.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── 로그인 시도 제한 ──────────────────────────────────────────────────────
# 연속 실패가 이 횟수에 닿으면 차단합니다(이메일 단위).
# IP 단위로 세지 않는 이유는 LoginAttemptService 주석을 보세요 —
# 브라우저가 Spring 을 직접 부르지 않아 모든 요청이 같은 주소로 보입니다.
LOGIN_MAX_ATTEMPTS=5
# 실패 기록이 유지되는 창(분). 이 시간 동안 조용하면 카운터가 사라집니다.
LOGIN_WINDOW_MINUTES=5
# 차단이 풀릴 때까지의 시간(분). 영구 잠금이 아닌 이유: 그러면 남의 계정을
# 일부러 잠글 수 있습니다(계정 잠금이 아니라 속도 제한입니다).
LOGIN_BLOCK_MINUTES=5

# ── 세션 쿠키 ─────────────────────────────────────────────────────────────
# JWT 는 httpOnly 쿠키로 내려갑니다(브라우저 JS 가 읽지 못합니다).
#
# HTTPS 로 서비스할 때만 true 로 두세요. http://localhost 시연에서 true 면
# 브라우저가 쿠키를 아예 저장하지 않아 **로그인이 되지 않습니다.**
COOKIE_SECURE=false

# ── 인증 ──────────────────────────────────────────────────────────────────
# 비워두면 기동할 때마다 임의 키가 생성돼 재기동 시 로그인이 풀립니다.
# setup.sh 가 자동으로 채웁니다. 직접 만들려면: openssl rand -base64 48
JWT_SECRET=

# 서비스 간 호출용 공유 비밀(/api/internal/**). setup.sh 가 채웁니다.
# 비워두면 백엔드가 임의 값을 만들고 경고를 남기며, 외부 수집기는 붙지 못합니다.
INTERNAL_SERVICE_TOKEN=
JWT_EXPIRATION_MINUTES=60

# ── 분류기 ────────────────────────────────────────────────────────────────
# 커서가 없을 때 되돌아볼 범위. 재분류하려면 커서를 지우고 이 값을 늘리세요.
#   rm tpotce/data/ml-classifier/cursor.json && docker compose restart ml-classifier
# 보관 로그(몇 달 전 데이터)를 적재했다면 now-1y 처럼 넉넉히 잡아야 합니다.
ML_BOOTSTRAP_WINDOW=now-24h
ML_POLL_INTERVAL_SEC=30
ML_BATCH_SIZE=1000

# 모델 확신도가 이 값 미만이면 "모르겠다"로 보고 라벨을 바꾸지 않습니다.
# (모델은 어차피 라벨을 뒤집지 못하고 ml_label_raw 에 자기 판단만 남깁니다.)
ML_CONF_THRESHOLD=0.5

# 분류 문서마다 찍히는 판별자 이름. 모델을 교체하면 이 값도 함께 올리세요 —
# 안 그러면 어느 모델이 판정한 문서인지 나중에 구분할 수 없습니다.
ML_MODEL_VERSION=rule-1.0+lgbm-v5

# ml-analysis-* 인덱스 템플릿의 이름. 기본값으로 충분합니다.
# 한 Elasticsearch 에 이 스택을 두 벌 올릴 때만 서로 다르게 주세요 —
# 같은 이름이면 나중에 뜬 쪽이 앞의 템플릿을 덮어씁니다.
ML_ES_TEMPLATE_NAME=ml-analysis

# ── 보존 기간 (ILM) ───────────────────────────────────────────────────────
# 분석 인덱스를 며칠 뒤에 지울지. **0 이면 지우지 않습니다(기본).**
#
# 기본이 0 인 이유: 이 저장소의 시연 데이터는 2026-04~05 의 보관 로그이고
# 보고서의 모든 수치가 거기서 나옵니다. 보존을 켜두면 어느 날 조용히 지워지고,
# 그때 화면은 비는 게 아니라 **숫자가 달라집니다** — 원인을 찾기도 어렵습니다.
#
# 라이브로 계속 돌릴 때 켜세요. 주의: ILM 의 나이는 인덱스 **생성 시각** 기준
# 입니다. 인덱스 이름이 2026.04.27 이어도 재색인한 날이 0일째이므로, 보관 로그를
# 적재한 장비에서 켜면 "켠 날로부터 N일 뒤" 에 사라집니다.
#
# 원본 logstash-* 는 건드리지 않습니다(재색인의 근거이자 유일한 복구 불가 자료).
ML_RETENTION_DAYS=0
LLM_RETENTION_DAYS=0

# ── 대시보드 집계 창 ──────────────────────────────────────────────────────
# 개요·통계가 몇 시간치를 집계할지. 라이브 운영이면 기본값이 맞지만,
# **보관된 로그를 적재해 시연할 땐 데이터가 몇 달 전이라 화면이 전부 0 이 됩니다.**
# 그때는 둘 다 now-1y 처럼 늘리세요.
THREAT_CONSOLE_WINDOW_SHORT=now-24h
THREAT_CONSOLE_WINDOW_LONG=now-7d

# ── LLM 추론 관문 (대시보드 온디맨드 분석) ────────────────────────────────
# /api/analyze/* 는 인증된 사용자만 호출할 수 있고, 아래 한도를 받습니다.
# ollama 는 요청을 직렬화합니다 — 실측으로 단독 60초, 동시 2건이면 두 번째가
# 82초였습니다. 여러 명이 몰리면 기다리게 두느니 바로 거절하는 편이 낫습니다.
LLM_QUOTA_WINDOW_MIN=10
LLM_QUOTA_PER_WINDOW=5
LLM_MAX_CONCURRENT=2

# ── 진단 ──────────────────────────────────────────────────────────────────
# 두 사이드카(ml-classifier · llm-analyzer)의 로그 상세도. 무엇을 왜 그렇게
# 분류했는지 보려면 DEBUG 로 올리세요. INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
