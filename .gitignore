# === 의존성 / 빌드 산출물 ===
node_modules/
.next/
out/
build/
.gradle/
target/
bin/

# === Python ===
__pycache__/
*.pyc
*.pyo

# === T-Pot 포크 (tpotce/) ===
# 2026-08-31: PR 트랙(tpot-fork/) 삭제로 tpotce/ 가 유일한 원본이 되었으므로
# 통째 제외를 해제한다. 소스(docker/ compose/ installer/ *.sh)는 추적하고,
# 아래 두 가지만 제외:
#   - data/    : 학습 데이터셋·모델 1.1GB (재생성 가능, *.pkl 은 아래에서도 제외)
#   - .env     : T-Pot 설정 + WEB_USER 자격증명
# 학습 데이터·모델(2GB)은 재생성 가능하므로 제외한다.
# 다만 compose 가 마운트하는 작은 설정 파일은 반드시 있어야 한다 —
# 없으면 Docker 가 같은 이름의 *디렉토리*를 만들어 프론트가 오작동한다.
#
# git 은 제외된 디렉토리 안의 파일을 다시 포함하지 못하므로,
# 디렉토리가 아니라 내용물을 단계별로 제외하며 내려간다.
tpotce/data/*
!tpotce/data/ml-classifier/
tpotce/data/ml-classifier/*
!tpotce/data/ml-classifier/models/
tpotce/data/ml-classifier/models/*
!tpotce/data/ml-classifier/models/active-metrics.json
tpotce/.env

# === 환경 / 비밀 ===
.env
.env.local
*.env
!*.env.example

# === 모델 바이너리 ===
*.pkl
*.joblib

# === OS / IDE ===
.DS_Store
*.iml
.idea/
.vscode/
*.log

# ── 데이터 (2026-09-22) ────────────────────────────────────────────────────
# 원본 공격 로그와 학습 데이터셋은 저장소에 두지 않는다 — 실제 공격자 IP,
# 자격증명 시도, SSH 세션 기록이 들어 있는 제3자 데이터다.
# 학습된 모델(models/*.pkl, encoders.json)은 파생 산출물이라 포함한다.
logs/
logs-staged/
tpotce/data/ml-classifier/dataset/
tpotce/data/ml-classifier/work-real/
tpotce/data/ml-classifier/cursor.json
tpotce/data/ml-classifier/heartbeat

# 백업(계정 해시 포함) · 세션 설정
backups/
.claude/
